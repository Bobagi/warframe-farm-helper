# Porta interna do app (o docker-compose publica em 127.0.0.1:3064)
PORT=3064

# Plataforma do worldstate (pc, ps4, xb1, swi)
WF_PLATFORM=pc

# ---- Busca web (fallback) — Google Programmable Search Engine ----
# Opcional: sem estas chaves o site degrada graciosamente para links de busca
# por site confiável. Como configurar: ver README.md ("Chaves do Google").
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Limite diário de chamadas ao Google CSE (cota gratuita ~100/dia)
CSE_DAILY_LIMIT=90
